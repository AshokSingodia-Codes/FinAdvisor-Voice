OPENAI_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AURA_INSTANCEID=xxxxxxxx
AURA_INSTANCENAME=InstanceXX
groq_api_key="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Database Configuration (Neon Serverless PostgreSQL)
# Recommended: Use the Pooled Connection String from Neon Dashboard with sslmode=require
# Format: postgresql://<user>:<password>@<neon-pooled-host>/<dbname>?sslmode=require
# If left unset, automatically falls back to local SQLite at data/conversations.db
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Auth Configuration
JWT_SECRET=finadvisor_secure_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Document Encryption Key (Fernet AES-128)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: If unset, an ephemeral per-process key is used (acceptable for local dev only).
# In production you MUST set this — encrypted documents are unreadable after restart without it.
ENCRYPTION_KEY=your_generated_fernet_key_here

# Brevo (Sendinblue) HTTPS Email API
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=your_email@gmail.com
BREVO_SENDER_NAME=FinAdvisor-X

# SMTP Email Configuration (Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_TLS=true
